/*
 * Append to arch/arm/boot/dts/ti/omap/am335x-boneblack.dts inside
 * `devtool modify linux-yocto`, then `devtool finish linux-yocto
 * <path>/meta-beaglebone-bsp` turns it into a patch in the BSP layer
 * (pin-mux and peripheral enables are board support, not application).
 *
 * Enables UART4 on the P9 header:  P9.11 = RX (gpmc_wait0, mode 6)
 *                                  P9.13 = TX (gpmc_wpn,   mode 6)
 * The device appears as /dev/ttyS4 (alias serial4 in am33xx.dtsi).
 */
&am33xx_pinmux {
	uart4_pins: uart4-pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_WAIT0, PIN_INPUT_PULLUP, MUX_MODE6)    /* P9.11 uart4_rxd */
			AM33XX_PADCONF(AM335X_PIN_GPMC_WPN, PIN_OUTPUT_PULLDOWN, MUX_MODE6)   /* P9.13 uart4_txd */
		>;
	};
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pins>;
	status = "okay";
};
